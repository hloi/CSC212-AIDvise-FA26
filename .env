# AI API keys
ANTHROPIC_API_KEY=your_key
OPENAI_API_KEY=your_key # Optional, only needed if you want to use OpenAI models
OPENROUTER_API_KEY=your-key # Optional, only needed if you want to use OpenRouter models

# Langchain configuration
# LANGCHAIN_API_KEY=your-api-key-here # Optional, only needed if you want to use langsmith tracing project management features
# LANGCHAIN_TRACING_V2=true


# export LANGSMITH_TRACING=false
# export LANGCHAIN_TRACING_V2=false
# unset LANGSMITH_API_KEY
# unset LANGCHAIN_API_KEY
export LANGSMITH_TRACING=false
export LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT="AIDvise"
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_API_KEY=ollama